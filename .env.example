# Необязательно: канал постоянной панели. Если не задан — используется SHIFTS_CHANNEL_ID.
PANEL_CHANNEL_ID=

# Реклама DeSanta: отдельный закрытый текстовый канал для Senior/Admin.
# 0 = новая система рекламы выключена, остальные функции бота работают.
ADS_REVIEW_CHANNEL_ID=0
ADS_FAMILY_NAME=DeSanta
ADS_CHECK_PERCENT=20
ADS_INTERVAL_MINUTES=3
ADS_RETENTION_DAYS=90
