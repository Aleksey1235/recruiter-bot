AUTO_MIGRATION_BACKUP=true
PING_RECRUITERS_ON_SHIFT_CREATE=true

GUILD_ID=0
RECRUITER_ROLE_ID=0
SENIOR_ROLE_ID=0
ADMIN_ROLE_ID=0

SHIFTS_CHANNEL_ID=0
REPORTS_CHANNEL_ID=0
STATS_CHANNEL_ID=0
CONTROL_CHANNEL_ID=0
LOGS_CHANNEL_ID=0

LATE_START_WARNING_MINUTES=10
MISS_AFTER_END_MINUTES=0
REPORT_REMINDER_AFTER_MINUTES=15
REVIEW_REMINDER_AFTER_MINUTES=30
SUSPICIOUS_SHORT_MINUTES=10
EARLY_START_MINUTES=10
MAX_SHIFT_DURATION_HOURS=12
MAX_SHIFT_SLOTS=25
MAX_STATIC_ID_LENGTH=32
WEEKLY_REPORT_HOUR=23
WEEKLY_REPORT_MINUTE=0
MAX_NOTIFICATION_ATTEMPTS=3
MAX_FINANCE_AMOUNT=1000000000
